# Copy this file to .env.local and adjust the values:
#   cp .env.example .env.local
#
# All variables start with NEXT_PUBLIC_ because the browser calls the API
# directly. Their values are built into the JavaScript bundle, so never put
# secrets here. Restart `pnpm dev` (or rebuild) after changing them.

# Banking API origin, without a trailing slash. Required.
NEXT_PUBLIC_API_BASE_URL=https://challenge-api.qena.dev

# "on" serves every API call from the built-in mock (MSW), so the app runs
# offline with sample data and no load on the shared API. Default: off.
NEXT_PUBLIC_API_MOCKING=off

# "on" shows the session inspector (token expiry, "expire access token now").
# For demos and debugging only. Default: off.
NEXT_PUBLIC_DEV_TOOLS=off
